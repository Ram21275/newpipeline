{
  "experiment_name": "signal_validation_pilot",
  "model": {
    "name_or_path": "REPLACE_WITH_EXISTING_LLAVA_LENS_CHECKPOINT",
    "revision": "REPLACE_WITH_PINNED_REVISION",
    "prompt_template": "Describe the image briefly.",
    "layers": [-8, -7, -6, -5, -4, -3, -2, -1]
  },
  "data": {
    "dataset": "cub_200_2011",
    "split_id": "pilot_train_20pct_seed_0",
    "train_fraction": 0.2
  },
  "cache": {
    "candidate_pool_size": 96,
    "hidden_dtype": "float16"
  },
  "routing": {
    "k_values": [16, 32],
    "seed": 0,
    "selectors": {
      "random": {"selector": "random", "score": "maxprob", "aggregate": "last"},
      "attention": {"selector": "attention", "score": "maxprob", "aggregate": "last"},
      "logit": {"selector": "logit", "score": "maxprob", "aggregate": "last"},
      "attention_logit": {"selector": "attention_logit", "score": "maxprob", "aggregate": "last"},
      "lger": {"selector": "lger", "score": "margin", "aggregate": "mean_layers"}
    }
  }
}
